# ---- Postgres / Redis ----
DATABASE_URL="postgresql://octapoint:octapoint@localhost:5432/octapoint"
REDIS_URL="redis://localhost:6379"

# ---- API Gateway ----
PORT=4000
NODE_ENV=development
ADMIN_TOKEN="dev-admin-token-change-me"
API_SECRET_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# "offchain"  -> fast-path Postgres ledger only, zero blockchain setup needed (default, used for the demo)
# "onchain"   -> also mirrors every issue/redeem onto the Sui Move contract
CHAIN_MODE=offchain

SUI_NETWORK=testnet
SUI_PACKAGE_ID=""
SUI_GATEWAY_SIGNER_SECRET=""

ENOKI_API_KEY=""

# "local"   -> writes audit records to ./.audit-store (default, no setup needed)
# "walrus"  -> publishes audit records to Walrus testnet
WALRUS_MODE=local
WALRUS_PUBLISHER_URL="https://publisher.walrus-testnet.walrus.space"

# ---- MCP Server ----
OCTAPOINT_BASE_URL="http://localhost:4000"
OCTAPOINT_KEY_ID=""
OCTAPOINT_SECRET=""
OCTAPOINT_MERCHANT_ID=""
MCP_HTTP_PORT=4100

# ---- Merchant portal ----
NEXT_PUBLIC_GATEWAY_URL="http://localhost:4000"
NEXT_PUBLIC_MERCHANT_ID=""

# ---- Admin portal ----
NEXT_PUBLIC_ADMIN_TOKEN="dev-admin-token-change-me"
API_SECRET_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ---- Stripe (billing) — optional, only needed if you wire up real billing ----
STRIPE_SECRET_KEY=""
